<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ split of cloud backup and device-to-device transfer. Both are governed at
  runtime by LocalScribeBackupAgent; these are the same fallback exclusions as
  backup_rules.xml, applied to each channel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models" />
        <exclude domain="database" path="localscribe.db" />
        <exclude domain="database" path="localscribe.db-wal" />
        <exclude domain="database" path="localscribe.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
        <exclude domain="database" path="localscribe.db" />
        <exclude domain="database" path="localscribe.db-wal" />
        <exclude domain="database" path="localscribe.db-shm" />
    </device-transfer>
</data-extraction-rules>
