# Copy to keystore.properties (gitignored) and fill in to build a signed release locally.
# CI supplies the same four values through the LOCALSCRIBE_* environment variables instead.
#
# Create the keystore once, then back up both the .jks file and these passwords somewhere
# durable -- losing either means never being able to update anyone who installed a release:
#
#   keytool -genkeypair -v -keystore localscribe-release.jks -alias localscribe \
#     -keyalg RSA -keysize 4096 -validity 10000

storeFile=localscribe-release.jks
storePassword=
keyAlias=localscribe
keyPassword=
